<%- include("_header") -%>

<h1>Find Customers</h1>


<div class="container">
    <h1>[YourLastName] Customer Management</h1>

    <div class="alert alert-info">
        <strong>Total Records in Database:</strong> <%= totalRecords %>
    </div>

    <fieldset>
        <legend>Find Records</legend>
        <form action="/manageCustomers" method="POST" class="mb-4">
            <div class="row">
                <div class="col">
                    <label for="custId">ID:</label>
                    <input type="number" name="custId" id="custId" class="form-control" 
                           value="<%= searchCriteria.custId || '' %>">
                </div>
                <div class="col">
                    <label for="firstName">First Name:</label>
                    <input type="text" name="firstName" id="firstName" class="form-control" 
                           value="<%= searchCriteria.firstName || '' %>">
                </div>
                <div class="col">
                    <label for="lastName">Last Name:</label>
                    <input type="text" name="lastName" id="lastName" class="form-control" 
                           value="<%= searchCriteria.lastName || '' %>">
                </div>
            </div>

            <div class="row mt-2">
                <div class="col">
                    <label for="state">State:</label>
                    <input type="text" name="state" id="state" class="form-control" 
                           maxlength="2" pattern="[A-Za-z]{2}" title="Enter 2-letter state code"
                           value="<%= searchCriteria.state || '' %>">
                </div>
                <div class="col">
                    <label for="salesYTD">Sales YTD:</label>
                    <input type="number" step="0.01" name="salesYTD" id="salesYTD" class="form-control" 
                           value="<%= searchCriteria.salesYTD || '' %>">
                </div>
                <div class="col">
                    <label for="prevSales">Previous Years Sales:</label>
                    <input type="number" step="0.01" name="prevSales" id="prevSales" class="form-control" 
                           value="<%= searchCriteria.prevSales || '' %>">
                </div>
            </div>

            <div class="mt-3">
                <button type="submit" class="btn btn-primary">Find</button>
                <a href="/manageCustomers" class="btn btn-secondary">Clear</a>
            </div>
        </form>
    </fieldset>

    <hr>

    <% if (message) { %>
        <div class="alert alert-warning"><%= message %></div>
    <% } %>

    <% if (model && model.length > 0) { %>
        <div class="d-flex justify-content-between align-items-center mb-2">
            <h2>Search Results</h2>
            <a href="/createCustomer" class="btn btn-success">Create Customer</a>
        </div>

        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>First Name</th>
                    <th>Last Name</th>
                    <th>State</th>
                    <th>Sales YTD</th>
                    <th>Prev Sales</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                <% model.forEach(customer => { %>
                    <tr>
                        <td><%= customer.custid %></td>
                        <td><%= customer.firstname %></td>
                        <td><%= customer.lastname %></td>
                        <td><%= customer.state %></td>
                        <td><%= customer.salesytd %></td>
                        <td><%= customer.previousyearssales %></td>
                        <td>
                            <a href="/editCustomer/<%= customer.custid %>" class="btn btn-sm btn-outline-primary">Edit</a>
                            <a href="/deleteCustomer/<%= customer.custid %>" class="btn btn-sm btn-outline-danger">Delete</a>
                        </td>
                    </tr>
                <% }); %>
            </tbody>
        </table>
    <% } %>
</div>

<%- include("_footer") -%>