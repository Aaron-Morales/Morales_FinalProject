<%- include("_header") -%>

    <h1>Find Customers</h1>

    <p>
        <strong>Total Customers in Database:</strong>
        <%= totalCount %>
    </p>

    <form action="/manageCustomers" method="GET">
        <label for="customerId">ID:</label>
        <input type="number" id="customerId" name="customerId" value="<%= search.customerId || '' %>">
        <br>

        <label for="firstName">First Name:</label>
        <input type="text" id="firstName" name="firstName" value="<%= search.firstName || '' %>">
        <br>

        <label for="lastName">Last Name:</label>
        <input type="text" id="lastName" name="lastName" value="<%= search.lastName || '' %>">
        <br>

        <label for="state">State:</label>
        <input type="text" id="state" name="state" maxlength="2" pattern="[A-Za-z]{2}"
            title="Enter a 2-letter state code" oninput="this.value = this.value.toUpperCase()"
            value="<%= search.state || '' %>">
        <br>

        <label for="salesYTD">Sales YTD:</label>
        <input type="number" id="salesYTD" name="salesYTD" step="0.01" value="<%= search.salesYTD || '' %>">
        <br>

        <label for="previousYearSales">Previous Year Sales:</label>
        <input type="number" id="previousYearSales" name="previousYearSales" step="0.01"
            value="<%= search.previousYearSales || '' %>">
        <br>

        <button type="submit">Find</button>
        <button type="button" onclick="window.location.href='/manageCustomers'">Clear</button>
    </form>

    <% if (message) { %>
        <p class="error">
            <%= message %>
        </p>
        <% } %>

            <% if (customers && customers.length===0 && Object.keys(search).length> 0) { %>
                <p class="error">No records were found.</p>
                <% } %>

                    <% if (customers && customers.length> 0) { %>
                        <h2>Search Results</h2>

                        <div style="margin-bottom: 10px;">
                            <button type="button" onclick="window.location.href='/createCustomer'">Create
                                Customer</button>
                        </div>

                        <table border="1" cellpadding="5">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>First Name</th>
                                    <th>Last Name</th>
                                    <th>State</th>
                                    <th>Sales YTD</th>
                                    <th>Previous Year Sales</th>
                                    <th>Edit</th>
                                    <th>Delete</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% customers.forEach(customer=> { %>
                                    <tr>
                                        <td>
                                            <%= customer.customer_id %>
                                        </td>
                                        <td>
                                            <%= customer.first_name %>
                                        </td>
                                        <td>
                                            <%= customer.last_name %>
                                        </td>
                                        <td>
                                            <%= customer.state %>
                                        </td>
                                        <td>$<%= Number(customer.sales_ytd || 0).toFixed(2) %>
                                        </td>
                                        <td>$<%= Number(customer.previous_year_sales || 0).toFixed(2) %>
                                        </td>
                                        <td>
                                            <a href="/editCustomer/<%= customer.customer_id %>">Edit</a>
                                        </td>
                                        <td>
                                            <form action="/deleteCustomer/<%= customer.customer_id %>" method="POST"
                                                style="display:inline;">
                                                <button type="submit"
                                                    onclick="return confirm('Are you sure you want to delete this customer?');">
                                                    Delete
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                    <% }) %>
                            </tbody>
                        </table>
                        <% } %>

                            <%- include("_footer") -%>