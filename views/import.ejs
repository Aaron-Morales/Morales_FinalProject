<%- include("_header") -%>

<div class="container">
    <h1>Import Customers</h1>
    <p><strong>Total records in database:</strong> <%= totalRecords %></p>

    <form action="/import" method="POST" enctype="multipart/form-data">
        <div class="mb-3">
            <label for="customerFile" class="form-label">Select a file for Database Insertion</label>
            <input type="file" name="customerFile" id="customerFile" class="form-control" required>
        </div>
        
        <button type="submit" class="btn btn-primary" onclick="showWait()">Import Customers</button>
    </form>

    <p id="waitMessage" style="display:none;" class="mt-3 text-info">
        Please wait for results... processing records.
    </p>
</div>

<script>
    function showWait() {
        const fileInput = document.getElementById('customerFile');
        if (fileInput.files.length > 0) {
            document.getElementById('waitMessage').style.display = 'block';
        }
    }
</script>

<%- include("_footer") -%>