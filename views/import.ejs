<%- include("_header") -%>

    <h1>Customer Import</h1>
    <h2>Total number of records in database: <%= totalRecords %></h2>
    <h2>Select a file with customer Database Insertion</h2>

    <form>  
        <input type="file" name="customerFile" required><p></p>
        <input type="submit">
    </form>
    <p id="result"></p>

    <script>
        document.querySelector("form").addEventListener("submit", e=>{
            e.preventDefault();
            const formData = new FormData(e.target);
            fetch("/import", {
                method: "POST",
                body: formData
            }).then(res=>res.text())
            .then(data=>{
                const resultElement = document.getElementById("result");
                if(data.substring(0,5) === "Error"){
                    resultElement.innerText = `Error occurred! ${data}`;
                } else {
                    resultElement.innerText = data;
                };
            }).catch(err=>{ 
                document.getElementById("message").textContent = `Error: ${err.message}`;
            });
        });
    </script>

    <%- include("_footer") -%>
