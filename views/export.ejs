<%- include("_header") %>

    <main>
        <h1>Customer Export</h1>
        <h2>Total Records in the Database: <%= totalRecords %></h2>
        <h2>Enter a file name and click "Export Customers"</h2>

       <form action="/export" method="post">
            <input type="submit" id=" submit" value="Download">
       </form>
       <% if(message.substring(0,5) === 'Error') { %>
            <h2>Error!</h2>
            <p><%= message %></p>
         <% } %>

    <%- include("_footer") %>