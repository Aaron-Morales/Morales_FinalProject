<%- include("_header") -%>

    <h1>Customer List Application</h1>
    <h2>Select a Task from the Top Navigation Bar</h2>

    <% if(message !=="success" ){%>
        <h1>We Encountered an Error</h1>
        <p><%= message %></p>
    <% } else {%>
        <h2>Total number of records in the database: <%= model.length %>
        </h2>
        <table class='table'>
            <thead class='thead-dark'>
                <tr>
                    <th scope='col'>ID</th>
                    <th scope='col'>First Name</th>
                    <th scope='col'>Last Name</th>
                    <th scope='col'>State</th>
                    <th scope='col'>Sales YTD</th>
                    <th scope='col'>Previous Years Sales</th>
                </tr>
            </thead>
            <tbody>
                <% model.forEach(custID=> { %>
                    </tr>
                        <td><%= custID_cusId %></td>
                        <td><%= custID_firstName %></td>
                        <td><%= custID_lastName %></td>
                        <td><%= custID_state %></td>
                        <td><%= custID_salesYTD %></td>
                        <td><%= custID_previousYearsSales %></td>   
                    </tr>
                <% }); %>
            </tbody>
        </table>
    <% } %>
</body>

</html>

<%- include("_footer") -%>