<%- include("_header") -%>

<div class="container">
    <h1>Delete Customer Confirmation</h1>
    <p class="text-danger"><strong>Are you sure you want to delete this record?</strong></p>

    <form action="/deleteCustomer/<%= customer.custid %>" method="POST">
        <div class="row mb-3">
            <div class="col">
                <label for="custid">ID:</label>
                <input type="text" id="custid" name="custid" class="form-control" 
                       value="<%= customer.custid %>" readonly>
            </div>
            <div class="col">
                <label for="firstName">First Name:</label>
                <input type="text" id="firstName" name="firstName" class="form-control" 
                       value="<%= customer.firstname %>" readonly>
            </div>
            <div class="col">
                <label for="lastName">Last Name:</label>
                <input type="text" id="lastName" name="lastName" class="form-control" 
                       value="<%= customer.lastname %>" readonly>
            </div>
        </div>

        <div class="row mb-3">
            <div class="col">
                <label for="state">State:</label>
                <input type="text" id="state" name="state" class="form-control" 
                       value="<%= customer.state %>" readonly>
            </div>
            <div class="col">
                <label for="salesYTD">Sales YTD:</label>
                <input type="text" id="salesYTD" name="salesYTD" class="form-control" 
                       value="<%= customer.salesytd %>" readonly>
            </div>
            <div class="col">
                <label for="prevSales">Previous Years Sales:</label>
                <input type="text" id="prevSales" name="prevSales" class="form-control" 
                       value="<%= customer.previousyearssales %>" readonly>
            </div>
        </div>

        <div class="mt-4">
            <button type="submit" class="btn btn-danger">Confirm Deletion</button>
            <a href="/manageCustomers" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>

<%- include("_footer") -%>