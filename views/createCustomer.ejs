<%- include("_header") -%>

<div class="container">
    <h1>Create Customer</h1>

    <% if (message && message.includes('Error')) { %>
        <div class="alert alert-danger"><%= message %></div>
    <% } %>

    <form action="/createCustomer" method="POST">
        <div class="row mb-3">
            <div class="col">
                <label for="custId">Customer ID:</label>
                <input type="number" id="custId" name="custId" class="form-control" 
                       value="<%= nextId %>" required>
            </div>
            <div class="col">
                <label for="firstName">First Name:</label>
                <input type="text" id="firstName" name="firstName" class="form-control" 
                       value="<%= (typeof formData !== 'undefined') ? formData.firstName : '' %>" required>
            </div>
            <div class="col">
                <label for="lastName">Last Name:</label>
                <input type="text" id="lastName" name="lastName" class="form-control" 
                       value="<%= (typeof formData !== 'undefined') ? formData.lastName : '' %>" required>
            </div>
        </div>

        <div class="row mb-3">
            <div class="col">
                <label for="state">State:</label>
                <input type="text" id="state" name="state" class="form-control" 
                       maxlength="2" pattern="[A-Za-z]{2}" 
                       value="<%= (typeof formData !== 'undefined') ? formData.state : '' %>">
            </div>
            <div class="col">
                <label for="salesYTD">Sales YTD:</label>
                <input type="number" step="0.01" id="salesYTD" name="salesYTD" class="form-control" 
                       value="<%= (typeof formData !== 'undefined') ? formData.salesYTD : '' %>">
            </div>
            <div class="col">
                <label for="previousYearsSales">Prev Year Sales:</label>
                <input type="number" step="0.01" id="previousYearsSales" name="previousYearsSales" class="form-control" 
                       value="<%= (typeof formData !== 'undefined') ? formData.previousYearsSales : '' %>">
            </div>
        </div>

        <button type="submit" class="btn btn-success">Create Customer</button>
        <a href="/manageCustomers" class="btn btn-secondary">Cancel</a>
    </form>
</div>

<%- include("_footer") -%>