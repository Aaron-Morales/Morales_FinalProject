<%- include("_header") -%>

    <h1>Create New Customer</h1>

    <form action="/createCustomer" method="POST">
        <label for="first_name">First Name:</label>
        <input type="text" id="first_name" name="first_name" required>
        <br>

        <label for="last_name">Last Name:</label>
        <input type="text" id="last_name" name="last_name" required>
        <br>

        <label for="state">State:</label>
        <input type="text" id="state" name="state" maxlength="2" pattern="[A-Za-z]{2}" title="2-letter state code"
            oninput="this.value = this.value.toUpperCase()" required>
        <br>

        <label for="sales_ytd">Sales YTD:</label>
        <input type="number" id="sales_ytd" name="sales_ytd" step="0.01" value="0.00">
        <br>

        <label for="previous_year_sales">Previous Year Sales:</label>
        <input type="number" id="previous_year_sales" name="previous_year_sales" step="0.01" value="0.00">
        <br>

        <button type="submit">Add Customer</button>
        <a href="/manageCustomers"><button type="button">Cancel</button></a>
    </form>

    <% if (locals.message) { %>
        <p class="<%= message.includes('success') ? 'success' : 'error' %>">
            <%= message %>
        </p>
        <% } %>

            <%- include("_footer") -%>